# ============================================================================
# MediTrack — Variables d'Environnement Modèles (US-01-T4 / MED-43)
# Copiez ce fichier vers .env : cp .env.example .env
# ============================================================================

# --- Application & Serveur ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:4200

# --- Base de données MongoDB ---
MONGO_URI=mongodb://mongo:27017/meditrack
MONGO_URI_LOCAL=mongodb://localhost:27017/meditrack

# --- Sécurité : JWT, Double Authentification (2FA) & Chiffrement RGPD ---
JWT_SECRET=change_me_super_secret_jwt_key_32chars_minimum
JWT_EXPIRES_IN=1d
TWO_FA_ISSUER=MediTrack-ENSAM
# Clé hexadécimale 64 caractères (32 octets) pour AES-256-GCM (US-14)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Notifications Email (Nodemailer / Mailtrap — US-19) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="MediTrack <no-reply@meditrack.ma>"

# --- Notifications SMS (Twilio Mode Test — US-20) ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+10000000000
