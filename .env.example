# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:4200

# MongoDB
MONGO_URI=mongodb://mongo:27017/meditrack

# Security (JWT & AES-256 RGPD Encryption)
JWT_SECRET=change_me_super_secret_jwt_key_32chars_min
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Notifications (Nodemailer - SMTP / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="MediTrack <no-reply@meditrack.ma>"

# SMS Notifications (Twilio - sandbox/mock in dev)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+10000000000
